{
  "name": "MassiveStoreLobby",
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$path": "src/ReplicatedFirst"
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/Lobby/ServerScriptService",
      "Services": {
        "$className": "Folder",
        "State": { "$path": "src/ServerScriptService/Services/State.lua" },
        "Data": { "$path": "src/ServerScriptService/Services/Data.lua" },
        "Progress": { "$path": "src/ServerScriptService/Services/Progress.lua" },
        "Shop": { "$path": "src/ServerScriptService/Services/Shop.lua" },
        "RateLimiter": { "$path": "src/ServerScriptService/Services/RateLimiter.lua" }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CameraMaxZoomDistance": 20,
        "CameraMinZoomDistance": 0.5,
        "CharacterWalkSpeed": 14,
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 7.2,
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/Lobby/StarterPlayerScripts",
        "Client": {
          "$className": "Folder",
          "UI": { "$path": "src/StarterPlayerScripts/Client/UI.lua" },
          "ClientState": { "$path": "src/StarterPlayerScripts/Client/ClientState.lua" },
          "Audio": { "$path": "src/StarterPlayerScripts/Client/Audio.lua" },
          "Pages": { "$path": "src/StarterPlayerScripts/Client/Pages.lua" },
          "TeleportScreen": { "$path": "src/StarterPlayerScripts/Client/TeleportScreen.lua" },
          "CharacterAnimator": { "$path": "src/StarterPlayerScripts/Client/CharacterAnimator.lua" }
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "Animate": {
          "$className": "LocalScript"
        },
        "Health": {
          "$className": "Script"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 2
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "Gravity": 196.2,
        "StreamingEnabled": false,
        "FallenPartsDestroyHeight": -200
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "Ambient": [0.09, 0.09, 0.11],
        "OutdoorAmbient": [0.12, 0.12, 0.16],
        "Brightness": 0.4,
        "ClockTime": 0.5,
        "EnvironmentDiffuseScale": 0.3,
        "EnvironmentSpecularScale": 0.6,
        "GlobalShadows": true,
        "FogColor": [0.04, 0.045, 0.06],
        "FogStart": 60,
        "FogEnd": 260,
        "ExposureCompensation": 0.2
      },
      "Sky": {
        "$className": "Sky",
        "$properties": {
          "StarCount": 1500,
          "CelestialBodiesShown": true,
          "MoonAngularSize": 9
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.8,
          "Size": 30,
          "Threshold": 1.2
        }
      },
      "Grade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Contrast": 0.12,
          "Saturation": -0.08,
          "TintColor": [0.96, 0.97, 1.0]
        }
      },
      "Haze": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.32,
          "Offset": 0.1,
          "Color": [0.2, 0.21, 0.26],
          "Decay": [0.1, 0.1, 0.14],
          "Glare": 0,
          "Haze": 1.4
        }
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "AmbientReverb": "ParkingLot"
      }
    }
  }
}
