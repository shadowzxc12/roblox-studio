	{ Id = "Screws", Name = "Screws", Category = "Material", Rarity = "Common", Stack = 40, Shape = "Box", Size = { 0.6, 0.4, 0.4 }, Color = "8d9aa6", Accent = "e0e0e0", Weight = 11, Desc = "Used in metal builds." },
