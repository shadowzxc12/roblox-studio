	{ Id = "Chocolate", Name = "Chocolate", Category = "Food", Rarity = "Uncommon", Stack = 10, Shape = "Box", Size = { 1, 0.15, 0.5 }, Color = "5d3a1a", Accent = "c0a080", Use = { Hunger = 14, Energy = 10 }, Desc = "Comfort food." },
