	{ Id = "Painkillers", Name = "Painkillers", Category = "Medical", Rarity = "Uncommon", Stack = 6, Shape = "Bottle", Size = { 0.35, 0.6, 0.35 }, Color = "ff7043", Accent = "ffffff", Use = { Heal = 35, HealOver = 6 }, Desc = "Heals 35 over 6 seconds." },
