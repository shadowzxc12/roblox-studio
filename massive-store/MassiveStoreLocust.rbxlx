	{ Id = "CannedBeans", Name = "Canned Beans", Category = "Food", Rarity = "Uncommon", Stack = 6, Shape = "Can", Size = { 0.6, 0.8, 0.6 }, Color = "9e9e9e", Accent = "8d4b2a", Use = { Hunger = 30 }, Desc = "Lasts forever. Fills you up." },
